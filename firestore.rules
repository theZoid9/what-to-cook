rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /meals/{mealId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /weeklyMeals/{recordId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /dinnerVotes/{dateKey} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.dateKey == dateKey
        && request.resource.data.main.type == 'main'
        && request.resource.data.side.type == 'side';
      allow update, delete: if false;

      match /votes/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && (request.resource.data.choice == 'yes' || request.resource.data.choice == 'no');
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /dinnerVoteState/current {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
